<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive background: the app's own dark surface, corner to corner.

  One flat colour on purpose. The mark is the whole foreground, so anything behind it would only
  survive in the corner slivers a square mask keeps. #15120F is `NightBase`, the same field the
  splash writes on.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF15120F"
        android:pathData="M0,0h108v108h-108z" />
</vector>
