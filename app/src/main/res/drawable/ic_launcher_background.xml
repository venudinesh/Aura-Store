<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive background: the dark field the badge sits on, corner to corner.

  It is a single colour on purpose. The disc, its ring-lit gradient and the wordmark are the
  foreground raster (drawable-xxxhdpi/ic_launcher_foreground.png), which is cut at 71 of the 108 units
  a launcher scales so the mask lands on the disc's own edge. That leaves this layer visible only in
  the corner slivers a square mask keeps, where any detail would be cropped anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF1E1E1E"
        android:pathData="M0,0h108v108h-108z" />
</vector>
