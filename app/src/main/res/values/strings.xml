    <string name="settings_why_switch">Why the switch exists</string>
    <string name="settings_why_switch_body">A normal app cannot install packages silently — that is enforced by Android itself. Allowing this app once lets installs continue without leaving the app again; the system\'s own confirmation still appears for each package.</string>
