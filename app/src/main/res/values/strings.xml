    <!-- The verification card, which is the differentiator and so gets the most careful wording. -->
    <string name="verify_title">Verification</string>
    <string name="verify_hashed">Hashed while it downloads</string>
    <string name="verify_hashed_body">SHA-256 is computed as the bytes stream, so nothing is read twice.</string>
    <string name="verify_parsed">Parsed before it can install</string>
    <string name="verify_parsed_body">Android\'s own package parser reads the file for its package name, version code and signing certificate, so a truncated or corrupt APK never reaches the installer.</string>
    <string name="verify_pinned">Signer pinned on first install</string>
    <string name="verify_pinned_body">The signing-certificate digest is stored, so a later update that arrives with a different key is visible rather than silent.</string>
    <string name="verify_cannot">What this cannot prove</string>
    <string name="verify_cannot_body">The catalogue publishes no file hashes or signatures. This establishes integrity and identity on the device — not that the catalogue intended to serve this file.</string>
    <string name="verify_this_download">This download</string>
