<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device through backup on Android 11 and older.

  `android:dataExtractionRules` is read by Android 12 and later only; before that the platform looks at
  `android:fullBackupContent` and ignores the newer attribute entirely. This file is the same list of
  exclusions in the older format, so the answer does not depend on the OS version. The queue in
  `SharedPreferences` carries signed download links, which are device-scoped credentials.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
